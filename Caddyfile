{
    admin off
    auto_https off
    persist_config off
}
:8080 {
    encode zstd gzip
    header X-Jaiscudderplumbing-Revision {$PLUMBING_REVISION}
    handle /healthz {
        header Cache-Control no-store
        header Content-Type application/json
        respond `{"ok":true,"revision":"{$PLUMBING_REVISION}"}` 200
    }
    handle {
        root * /srv
        @fingerprinted path /_astro/*
        @unfingerprinted not path /_astro/*
        header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
        header @unfingerprinted Cache-Control no-cache
        try_files {path} {path}/index.html =404
        file_server
    }
}
